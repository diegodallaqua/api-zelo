# Copie para .env (não versionado) e ajuste. Variáveis lidas pelo application.yml.

# Banco (PostgreSQL + PostGIS)
DB_URL=jdbc:postgresql://localhost:5432/zelo
DB_USERNAME=zelo
DB_PASSWORD=troque-esta-senha

# JWT: segredo HMAC com no mínimo 32 caracteres. Gere com: openssl rand -base64 48
ZELO_JWT_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres

# Origens liberadas no CORS (painel web), separadas por vírgula
ZELO_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Administrador criado na primeira inicialização (se ainda não existir nenhum)
ZELO_ADMIN_EMAIL=admin@zelo.local
ZELO_ADMIN_SENHA=troque-esta-senha1
# Endereço do administrador inicial (obrigatório). Cidade = código IBGE (3550308 = São Paulo).
ZELO_ADMIN_CEP=01002020
ZELO_ADMIN_RUA=Viaduto do Chá
ZELO_ADMIN_BAIRRO=Centro
ZELO_ADMIN_NUMERO=15
ZELO_ADMIN_COMPLEMENTO=
ZELO_ADMIN_CIDADE_ID=3550308

# Armazenamento de fotos: local | r2
ZELO_ARMAZENAMENTO=local
ZELO_ARMAZENAMENTO_DIR=./uploads
ZELO_ARMAZENAMENTO_URL=http://localhost:8080/arquivos

# Cloudflare R2 (apenas quando ZELO_ARMAZENAMENTO=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_URL_PUBLICA=
